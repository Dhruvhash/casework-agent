// Create the empty FraudInvestigation graph in Savanna first.
// Then run this job once to add local types without changing Transaction_Fraud.
CREATE SCHEMA_CHANGE JOB HHG_AddSchema FOR GRAPH FraudInvestigation {
ADD VERTEX HHG_Customer (PRIMARY_ID customer_id STRING);
ADD VERTEX HHG_Card (PRIMARY_ID card_id STRING);
ADD VERTEX HHG_Transaction (PRIMARY_ID txn_id STRING, ts STRING, amount_usd DOUBLE, channel STRING, risk_score DOUBLE, product_code STRING, issuer_code_card1 STRING, billing_region STRING, p_emaildomain STRING, r_emaildomain STRING, source_transaction_id STRING);
ADD VERTEX HHG_DeviceProfile (PRIMARY_ID device_id STRING, profile STRING);
ADD VERTEX HHG_EmailDomain (PRIMARY_ID email_domain STRING);
ADD VERTEX HHG_BillingRegion (PRIMARY_ID billing_region STRING);
ADD VERTEX HHG_ClosedCase (PRIMARY_ID case_id STRING, outcome STRING, pattern STRING, exposure_usd DOUBLE, analyst_notes STRING);
ADD VERTEX HHG_InvestigationCase (PRIMARY_ID case_id STRING, status STRING, verdict STRING, fraud_probability DOUBLE, summary STRING, updated_at STRING);
ADD DIRECTED EDGE HHG_OWNS (FROM HHG_Customer, TO HHG_Card) WITH REVERSE_EDGE="HHG_OWNED_BY";
ADD DIRECTED EDGE HHG_HAS_TRANSACTION (FROM HHG_Customer, TO HHG_Transaction) WITH REVERSE_EDGE="HHG_TRANSACTION_OF";
ADD DIRECTED EDGE HHG_KNOWN_CARD_TRANSACTION (FROM HHG_Card, TO HHG_Transaction, provenance STRING) WITH REVERSE_EDGE="HHG_KNOWN_ON_CARD";
ADD DIRECTED EDGE HHG_NEXT_CUSTOMER_TRANSACTION (FROM HHG_Transaction, TO HHG_Transaction) WITH REVERSE_EDGE="HHG_PREVIOUS_CUSTOMER_TRANSACTION";
ADD DIRECTED EDGE HHG_FROM_DEVICE (FROM HHG_Transaction, TO HHG_DeviceProfile, device_new STRING, proxy_type STRING) WITH REVERSE_EDGE="HHG_DEVICE_USED_FOR";
ADD DIRECTED EDGE HHG_HAS_EMAIL_DOMAIN (FROM HHG_Transaction, TO HHG_EmailDomain, email_role STRING) WITH REVERSE_EDGE="HHG_EMAIL_USED_FOR";
ADD DIRECTED EDGE HHG_BILLED_IN (FROM HHG_Transaction, TO HHG_BillingRegion) WITH REVERSE_EDGE="HHG_REGION_OF_TRANSACTION";
ADD DIRECTED EDGE HHG_CLOSED_CASE_ON_CARD (FROM HHG_ClosedCase, TO HHG_Card) WITH REVERSE_EDGE="HHG_CARD_IN_CLOSED_CASE";
ADD DIRECTED EDGE HHG_CLOSED_CASE_INVOLVES (FROM HHG_ClosedCase, TO HHG_Transaction) WITH REVERSE_EDGE="HHG_TRANSACTION_IN_CLOSED_CASE";
ADD DIRECTED EDGE HHG_INVESTIGATION_OF (FROM HHG_InvestigationCase, TO HHG_Transaction) WITH REVERSE_EDGE="HHG_INVESTIGATED_IN";
ADD DIRECTED EDGE HHG_INVESTIGATION_FOR_CUSTOMER (FROM HHG_InvestigationCase, TO HHG_Customer) WITH REVERSE_EDGE="HHG_CUSTOMER_INVESTIGATION";
}
RUN SCHEMA_CHANGE JOB HHG_AddSchema
