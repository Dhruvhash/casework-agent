# TigerGraph Savanna workspace details. Never commit the filled .env file.
TG_HOST=
TG_GRAPHNAME=FraudInvestigation
# Recommended for Savanna 4.2: create under Database Secrets.
TG_SECRET=
TG_API_TOKEN=
# Optional if your workspace uses user/password authentication instead of a token.
TG_USERNAME=
TG_PASSWORD=
# Official TigerGraph MCP can run as local stdio or as Streamable HTTP.
TG_MCP_TRANSPORT=stdio
TG_MCP_URL=

# Free development: uses existing local models; never downloads automatically.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_GPU=0
EMBEDDING_MODEL=nomic-embed-text:latest
# Recommended final demo option. API usage is billed separately.
# To enable, set LLM_PROVIDER=openai and supply your own key locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
